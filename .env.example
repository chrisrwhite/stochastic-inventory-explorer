# Example environment variables for the stochastic-inventory-reorder backend.
# Copy to `.env` (or export in your shell) and edit as needed. All values are
# optional - the defaults are shown below and are fine for local development.

# ---- Backend server ----

# Where the FastAPI process finds the bundled scenario data (demand.csv,
# costs.yaml, lead_time.yaml). The default resolves relative to the backend
# package and only needs to be set if you're running from a non-standard
# working directory.
# SCENARIO_DATA_DIR=/absolute/path/to/backend/data/scenarios

# Path to the built React SPA (Vite `frontend/dist`), served as static files.
# The Docker image bakes this into `app/static/`. In dev you typically run the
# Vite dev server separately and leave this unset.
# STATIC_DIR=/absolute/path/to/app/static

# Python logging level for uvicorn + app loggers.
LOG_LEVEL=INFO

# ---- Compute limits ----
#
# These bound what a caller can ask the public API to compute. The deployed
# service sets them well below the values here -- see infra/variables.tf, which
# is the source of truth for production. Measured runtimes on a fast laptop:
#
#   2000 sims x 180 days ->  11 s  <- what the UI sends
#   4000 sims x 180 days ->  23 s  <- the deployed ceiling
#  10000 sims x 365 days -> 251 s, 727 MB  <- the schema's own ceiling
#
# Requests above the ceiling are silently clamped down by _clamp_request rather
# than rejected.

# Upper bound on Monte-Carlo trajectories per optimization request. Increase
# for smoother frontiers, decrease if you're deploying to a small container.
MAX_N_SIMULATIONS=10000

# Upper bound on simulation horizon in days. Longer horizons average out
# noise but cost more CPU and memory. Cost is superlinear here: doubling 180
# to 365 roughly quadruples the runtime.
MAX_HORIZON_DAYS=365

# Simulations allowed to run concurrently on one instance. A sweep is
# single-threaded numpy that pins one core for its whole duration, so keep this
# at or below the container's vCPU count -- beyond that, sweeps thrash instead
# of overlapping. Requests arriving with no slot free get an immediate JSON 429
# instead of queueing. Cheap requests (/api/health, /api/scenarios, static
# assets) are never gated by this.
MAX_CONCURRENT_SIMULATIONS=2

# ---- CORS ----

# Comma-separated list of allowed frontend origins. The default (used when
# unset) allows the Vite dev server at http://localhost:5173. In production
# behind Cloudflare, set this to your deployed frontend origin, e.g.
# CORS_ORIGINS=https://inventory.example.com
# CORS_ORIGINS=

# ---- Kaggle credentials (only for scripts/fetch_open_datasets.py) ----
#
# See README section "Pulling the M5 and Favorita scenarios" for details. Not
# required to run the app - only to refresh the Kaggle-derived scenarios.
# KAGGLE_API_TOKEN=KGAT_...
