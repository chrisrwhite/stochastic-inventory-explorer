.dockerignore.local

# Terraform. State holds resource metadata and tfvars holds project
# identifiers, so neither is committed. `.terraform.lock.hcl` deliberately is
# committed -- it pins provider versions so everyone plans against the same
# provider build.
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.*
infra/terraform.tfvars
*.tfplan

# Private operational notes. This repo is public; DEPLOYMENT.local.md holds the
# GCP project identifiers, service-account emails, billing account and console
# deep links for the live deployment. `docs/deploy.md` is the public, generic
# version of the same walkthrough. Anything matching *.local.md stays local.
DEPLOYMENT.local.md
*.local.md

# Local env
.env
.env.local
.envrc
.direnv/

# Kaggle credentials (defense in depth; the real ones live under ~/.kaggle)
.kaggle/
kaggle.json
access_token

# Cached raw open-dataset downloads (regenerated by scripts/fetch_open_datasets.py)
backend/data/scenarios/_raw/
